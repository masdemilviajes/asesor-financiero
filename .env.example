# Copia este archivo como .env.local y llena los valores.
# Nunca subas .env.local a GitHub.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secreta: solo la usan los crons en el servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Único correo que puede iniciar sesión
ALLOWED_EMAIL=

# Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Resend (resend.com)
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=onboarding@resend.dev

# Protege las rutas /api/cron/*
CRON_SECRET=

# Opcionales (estos son los valores por defecto)
NEXT_PUBLIC_APP_CURRENCY=AUD
NEXT_PUBLIC_APP_TIMEZONE=Australia/Sydney
